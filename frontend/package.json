    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:gallery": "vite build",
    "build:legacy": "vite build --config vite.legacy.config.ts",
    "build:business": "vite build --config vite.business.config.ts && node scripts/sync-business-ui.mjs",
    "build:production": "pnpm build:business && vite build --config vite.production.config.ts && node scripts/build-legacy-island-css.mjs && node scripts/sync-production-dsh.mjs",
    "build:dsh-domain": "node scripts/build-dsh-domain-plugin.mjs",
    "build": "pnpm tokens && tsc --noEmit && pnpm build:gallery && pnpm build:legacy && node scripts/write-build-metadata.mjs",
    "generate:dsh-client-manifest": "node scripts/generate-dsh-client-accepted-manifest.mjs",
    "check:dsh-client-manifest": "node scripts/generate-dsh-client-accepted-manifest.mjs --check",
    "probe:dsh-client-composition": "node scripts/probe-dsh-client-composition.mjs",
    "probe:dsh-client-composition:stability": "node scripts/probe-dsh-client-composition-stability.mjs",
    "sync:production-foundation": "node scripts/sync-production-foundation.mjs",
